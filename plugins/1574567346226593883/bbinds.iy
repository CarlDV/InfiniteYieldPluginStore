local EditSizeInput = CreateInput(
    EditBackground,
    'EditSize',
    `Size ({Config.MinimumButtonSize}-{Config.MaximumButtonSize}px)`,
    UDim2.fromOffset(10, 85),
    UDim2.fromOffset(110, 20)
)

local MinusButton = CreateTextButton(EditBackground, 'Minus', '-', UDim2.fromOffset(125, 85), UDim2.fromOffset(30, 20), currentShade2, currentText1)

local PlusButton = CreateTextButton(EditBackground, 'Plus', '+', UDim2.fromOffset(160, 85), UDim2.fromOffset(30, 20), currentShade2, currentText1)

local function ApplySize(Size)
    local Target = EditTarget

    if not Target or not Target.Gui or ActiveDrag == Target then
        return
    end

    local RequestedSize = NormalizeSize(Size)

    Target.Size, Target.Position = FindFreeSize(Target, RequestedSize)

    Target.Gui.Size = UDim2.fromOffset(Target.Size, Target.Size)
    Target.Gui.Position = UDim2.fromScale(Target.Position[1], Target.Position[2])

    EditSizeInput.Text = tostring(Target.Size)
    EditDirty = true

    if Target.Size < RequestedSize then
        notify('BBinds', 'There is no free space to enlarge this button')
    end
end

local function ApplyField(Field, Input, Label)
    local Target = EditTarget

    if not Target or not Target.Gui then
        return
    end

    local Value = Trim(Input.Text)

    if Label and Value == '' then
        Input.Text = Target[Field]

        return notify('BBinds', `The {Label} must not be empty`)
    end

    local NewValue = Value ~= '' and Value or nil

    Input.Text = Value

    if Target[Field] == NewValue then
        return
    end

    Target[Field] = NewValue
    Target.Gui.Text = Target.Text

    EditDirty = true
end

local function CommitEdit()
    if not EditDirty then
        return
    end

    EditDirty = false

    SaveButtons()
    RefreshButtons()
end

function OpenEditWindow(Data)
    if EditTarget ~= Data then
        CommitEdit()
    end

    EditTarget = Data
    EditTextInput.Text = Data.Text
    EditCommandInput.Text = Data.Command
    EditSecondCommandInput.Text = Data.SecondCommand or ''
    EditSizeInput.Text = tostring(Data.Size)

    SetCreationWindowVisible(false)
    SlideWindow(EditGui, true)
end

function CloseEditWindow()
    if not EditTarget then
        return
    end

    CommitEdit()

    EditTarget = nil

    SlideWindow(EditGui, false)
end

-- // Buttons
local function CreateButton(Data)
    Data.Size = NormalizeSize(Data.Size)

    PlaceButton(Data)

    local Gui = Instance.new('TextButton')
    Gui.Name = 'BBind_' .. randomString()
    Gui.Parent = ScreenGui
    Gui.BackgroundColor3 = currentShade1
    Gui.TextColor3 = currentText1
    Gui.BorderSizePixel = 0
    Gui.Size = UDim2.fromOffset(Data.Size, Data.Size)
    Gui.Position = UDim2.fromScale(Data.Position[1], Data.Position[2])
    Gui.Text = Data.Text
    Gui.TextTruncate = Enum.TextTruncate.AtEnd
    Gui.Font = Enum.Font.SourceSans
    Gui.AutoButtonColor = true
    Gui.TextScaled = Config.TextScaled

    if not Config.TextScaled then
        Gui.TextSize = Config.TextSize
    end

    RegisterTheme(Gui, shade1, text1)

    Data.Gui = Gui

    Buttons[#Buttons + 1] = Data

    local IsToggled = false

    Gui.Activated:Connect(function()
        if IsEditing then
            return
        end

        IsToggled = not IsToggled
    
        Gui.BackgroundColor3 = IsToggled and currentShade3 or currentShade1

        execCmd(IsToggled and Data.Command or (Data.SecondCommand or Data.Command))
    end)

    Gui.InputBegan:Connect(function(Input)
        if not IsEditing or ActiveDrag then
            return
        end

        local InputType = Input.UserInputType
        local IsTouch = InputType == Enum.UserInputType.Touch

        if not IsTouch and InputType ~= Enum.UserInputType.MouseButton1 then
            return
        end

        local function GetPointer()
            return IsTouch and Vector2.new(Input.Position.X, Input.Position.Y) or UserInputService:GetMouseLocation()
        end

        local StartPointer = GetPointer()
        local StartPosition = Gui.Position

        local StartPixels = ToPixels(Data.Position)
        local CurrentPixels = StartPixels

        local MovedDistance = 0
        local IsDragging = true

        local Connections = {}

        ActiveDrag = Data

        Gui.AutoButtonColor = false

        local function StopDragging()
            if not IsDragging then
                return
            end

            IsDragging = false
            ActiveDrag = nil
            Gui.AutoButtonColor = true

            for _, Connection in ipairs(Connections) do
                Connection:Disconnect()
            end

            table.clear(Connections)

            if not Gui.Parent then
                return
            end

            if MovedDistance < Config.DragThreshold then
                Gui.Position = StartPosition

                return OpenEditWindow(Data)
            end

            Data.Position = ToScale(CurrentPixels)
            Gui.Position = UDim2.fromScale(Data.Position[1], Data.Position[2])

            SaveButtons()
        end

        Connections[1] = RunService.RenderStepped:Connect(function()
            if not Gui.Parent then
                return StopDragging()
            end

            local Viewport = GetViewportSize()
            local Delta = GetPointer() - StartPointer

            MovedDistance = math.max(MovedDistance, Delta.Magnitude)

            local Target = Vector2.new(
                math.clamp(StartPixels.X + Delta.X, 0, math.max(0, Viewport.X - Data.Size)),
                math.clamp(StartPixels.Y + Delta.Y, 0, math.max(0, Viewport.Y - Data.Size))
            )

            CurrentPixels = Vector2.new(MoveAlong(Data, 'X', CurrentPixels, Target.X), CurrentPixels.Y)
            CurrentPixels = Vector2.new(CurrentPixels.X, MoveAlong(Data, 'Y', CurrentPixels, Target.Y))

            Gui.Position = UDim2.fromScale(CurrentPixels.X / math.max(Viewport.X, 1), CurrentPixels.Y / math.max(Viewport.Y, 1))
        end)

        Connections[2] = UserInputService.InputEnded:Connect(function(EndedInput)
            if EndedInput == Input or (not IsTouch and EndedInput.UserInputType == Enum.UserInputType.MouseButton1) then
                StopDragging()
            end
        end)
    end)

    return Data
end

-- // Initial Load
for _, Data in ipairs(LoadButtons()) do
    CreateButton(Data)
end

RefreshButtons()

-- // UI Interaction
SettingsButton.Activated:Connect(function()
    ManagementFrame:TweenPosition(UDim2.fromOffset(0, 0), 'InOut', 'Quart', 0.5, true, function()
        SettingsHolder.Visible = false
    end)
end)

CloseButton.Activated:Connect(function()
    SettingsHolder.Visible = true

    ManagementFrame:TweenPosition(UDim2.fromOffset(0, 175), 'InOut', 'Quart', 0.5, true)
end)

AddButton.Activated:Connect(function()
    SetCreationWindowVisible(true)
end)

local function ToggleEditMode()
    IsEditing = not IsEditing

    EditButton.Text = IsEditing and 'Edit mode: ON' or 'Edit mode'
    EditButton.BackgroundColor3 = IsEditing and currentShade3 or currentShade2

    if not IsEditing then
        CloseEditWindow()
    end

    notify('BBinds', IsEditing and 'Editing mode has been enabled' or 'Editing mode has been disabled')
end

EditButton.Activated:Connect(ToggleEditMode)

ClearButton.Activated:Connect(RemoveAllButtons)

CreationClose.Activated:Connect(function()
    ClearCreationInputs()
    SetCreationWindowVisible(false)
end)

EditClose.Activated:Connect(CloseEditWindow)

MinusButton.Activated:Connect(function()
    if EditTarget then
        ApplySize(EditTarget.Size - Config.ResizeStep)
    end
end)

PlusButton.Activated:Connect(function()
    if EditTarget then
        ApplySize(EditTarget.Size + Config.ResizeStep)
    end
end)

EditTextInput.FocusLost:Connect(function()
    ApplyField('Text', EditTextInput, 'button text')
end)

EditCommandInput.FocusLost:Connect(function()
    ApplyField('Command', EditCommandInput, 'command')
end)

EditSecondCommandInput.FocusLost:Connect(function()
    ApplyField('SecondCommand', EditSecondCommandInput)
end)

EditSizeInput.FocusLost:Connect(function()
    if not EditTarget then
        return
    end

    local RequestedSize = tonumber(Trim(EditSizeInput.Text))

    if RequestedSize then
        ApplySize(RequestedSize)
    else
        EditSizeInput.Text = tostring(EditTarget.Size)

        notify('BBinds', 'Button size must be a number')
    end
end)

ToggleButton.Activated:Connect(function()
    IsCreatingToggle = not IsCreatingToggle

    ToggleButton.BackgroundTransparency = IsCreatingToggle and 0 or 1
    SecondCommandHolder.Visible = IsCreatingToggle
end)

CreationAddButton.Activated:Connect(function()
    local ButtonText = Trim(TextInput.Text)

    local Command = Trim(CommandInput.Text)
    local SecondCommand = Trim(SecondCommandInput.Text)

    local RequestedSize = Trim(SizeInput.Text)

    if ButtonText == '' then
        return notify('BBinds', 'The button text must not be empty')
    end

    if Command == '' then
        return notify('BBinds', 'The command must not be empty')
    end

    if IsCreatingToggle and SecondCommand == '' then
        return notify('BBinds', 'The second command must not be empty')
    end

    local Size = Config.DefaultButtonSize

    if RequestedSize ~= '' then
        Size = tonumber(RequestedSize)

        if not Size then
            return notify('BBinds', 'Button size must be a number')
        end

        if Size < Config.MinimumButtonSize or Size > Config.MaximumButtonSize then
            return notify('BBinds', `Button size must be between {Config.MinimumButtonSize} and {Config.MaximumButtonSize}px`)
        end
    end

    local Viewport = GetViewportSize()

    local NewButton = CreateButton({
        Text = ButtonText,
        Command = Command,
        SecondCommand = IsCreatingToggle and SecondCommand or nil,
        Position = {20 / math.max(Viewport.X, 1), 20 / math.max(Viewport.Y, 1)},
        Size = NormalizeSize(Size)
    })

    RefreshButtons()
    SaveButtons()

    notify('BBinds', `The BBind {NewButton.Text} has been created ({NewButton.Size}px)`)

    ClearCreationInputs()
    SetCreationWindowVisible(false)
end)

return {
    ['PluginName'] = 'BBinds',
    ['PluginDescription'] = 'Adds configurable Button Binds to Infinite Yield',
    ['Commands'] = {
        ['enablebbind'] = {
            ['ListName'] = 'EnableBBind',
            ['Description'] = 'Turn BBinds Visible',
            ['Aliases'] = {'bbind', 'enablebb'},
            ['Function'] = function()
                ScreenGui.Enabled = true
            end
        },
        ['disablebbind'] = {
            ['ListName'] = 'DisableBBind',
            ['Description'] = 'Turn BBinds not Visible',
            ['Aliases'] = {'unbbind', 'disablebb'},
            ['Function'] = function()
                ScreenGui.Enabled = false
            end
        },
        ['bbindeditmode'] = {
            ['ListName'] = 'BBind EditMode',
            ['Description'] = 'Toggle BBind EditMode',
            ['Aliases'] = {'bbindedit', 'bbeditmode'},
            ['Function'] = function()
                if not (ScreenGui and ScreenGui.Enabled) then
                    return notify('BBinds', 'BBinds is Disable. Cannot Activate EditMode')
                end

                ToggleEditMode()
            end
        }
    }
}