local ScreenGui = Instance.new('ScreenGui', PARENT)
ScreenGui.Name = 'BBinds'
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true

local function CreateWindow(Name, Title, Width, Height)
    local Gui = Instance.new('Frame')
    Gui.Name = Name
    Gui.Parent = ScreenGui
    Gui.Active = true
    Gui.BackgroundTransparency = 1
    Gui.Position = UDim2.new(0.5, -Width / 2, 0, -500)
    Gui.Size = UDim2.fromOffset(Width, 20)
    Gui.ZIndex = 10

    dragGUI(Gui)

    local Background = Instance.new('Frame')
    Background.Name = 'Background'
    Background.Parent = Gui
    Background.Active = true
    Background.BackgroundColor3 = currentShade1
    Background.BorderSizePixel = 0
    Background.Position = UDim2.fromOffset(0, 20)
    Background.Size = UDim2.fromOffset(Width, Height)
    Background.ZIndex = 10

    RegisterTheme(Background, shade1)

    local TitleBar = Instance.new('Frame')
    TitleBar.Name = 'Title'
    TitleBar.Parent = Gui
    TitleBar.BackgroundColor3 = currentShade2
    TitleBar.BorderSizePixel = 0
    TitleBar.Size = UDim2.fromOffset(Width, 20)
    TitleBar.ZIndex = 10

    RegisterTheme(TitleBar, shade2)

    local TitleText = Instance.new('TextLabel')
    TitleText.Name = 'Text'
    TitleText.Parent = TitleBar
    TitleText.BackgroundTransparency = 1
    TitleText.Size = UDim2.new(1, -25, 1, 0)
    TitleText.Font = Enum.Font.SourceSans
    TitleText.Text = Title
    TitleText.TextColor3 = currentText1
    TitleText.TextSize = 14
    TitleText.ZIndex = 10

    RegisterTheme(TitleText, nil, text1)

    local WindowClose = Instance.new('TextButton')
    WindowClose.Name = 'Close'
    WindowClose.Parent = TitleBar
    WindowClose.BackgroundTransparency = 1
    WindowClose.Position = UDim2.new(1, -20, 0, 0)
    WindowClose.Size = UDim2.fromOffset(20, 20)
    WindowClose.ZIndex = 10
    WindowClose.Text = ''

    local CloseIcon = Instance.new('ImageLabel')
    CloseIcon.Name = 'Icon'
    CloseIcon.Parent = WindowClose
    CloseIcon.BackgroundTransparency = 1
    CloseIcon.Position = UDim2.fromOffset(5, 5)
    CloseIcon.Size = UDim2.fromOffset(10, 10)
    CloseIcon.ZIndex = 10
    CloseIcon.Image = 'rbxassetid://5054663650'

    return Gui, Background, WindowClose
end

local function SlideWindow(Gui, IsVisible)
    Gui:TweenPosition(UDim2.new(0.5, -Gui.Size.X.Offset / 2, 0, IsVisible and 100 or -500), 'InOut', 'Quart', 0.5, true)
end

local function CreateInput(Parent, Name, Placeholder, Position, Size)
    local Holder = Instance.new('Frame')
    Holder.Name = Name .. 'Holder'
    Holder.Parent = Parent
    Holder.BackgroundColor3 = currentShade2
    Holder.BorderSizePixel = 0
    Holder.ClipsDescendants = true
    Holder.Position = Position
    Holder.Size = Size
    Holder.ZIndex = 10

    RegisterTheme(Holder, shade2)

    local Input = Instance.new('TextBox')
    Input.Name = Name
    Input.Parent = Holder
    Input.BackgroundTransparency = 1
    Input.BorderSizePixel = 0
    Input.Position = UDim2.fromOffset(2, 0)
    Input.Size = UDim2.new(1, -8, 1, 0)
    Input.ZIndex = 10
    Input.Font = Enum.Font.SourceSans
    Input.PlaceholderColor3 = Color3.fromRGB(255, 255, 255)
    Input.PlaceholderText = Placeholder
    Input.Text = ''
    Input.TextColor3 = currentText1
    Input.TextSize = 14
    Input.TextXAlignment = Enum.TextXAlignment.Left

    RegisterTheme(Input, nil, text1)

    return Input, Holder
end

