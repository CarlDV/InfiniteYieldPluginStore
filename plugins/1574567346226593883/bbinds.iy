-- // Configuration
local Config = {
    DefaultButtonSize = 50,
    MinimumButtonSize = 30,
    MaximumButtonSize = 250,

    ResizeStep = 10,
    DragThreshold = 6,
    CollisionTolerance = 0.01,

    TextScaled = true,
    TextSize = 50
}

-- // States
local Buttons = {}
local ListEntries = {}

local IsEditing = false
local IsCreatingToggle = false
local IsCreationWindowOpen = false

local ActiveDrag

local EditTarget
local EditDirty = false

local OpenEditWindow, CloseEditWindow

-- // Helpers
local function Trim(Value)
    return (string.gsub(Value, '^%s*(.-)%s*$', '%1'))
end

local function IsFilledString(Value)
    return typeof(Value) == 'string' and Trim(Value) ~= ''
end

local function ClampPosition(X, Y)
    return math.clamp(tonumber(X) or 0.05, 0, 1), math.clamp(tonumber(Y) or 0.05, 0, 1)
end

local function NormalizeSize(Value)
    local Size = tonumber(Value) or Config.DefaultButtonSize

    return math.clamp(math.floor(Size + 0.5), Config.MinimumButtonSize, Config.MaximumButtonSize)
end

local function RegisterTheme(Object, ShadeGroup, TextGroup)
    if ShadeGroup then
        table.insert(ShadeGroup, Object)
    end

    if TextGroup then
        table.insert(TextGroup, Object)
    end
end

local function UnregisterTheme(Object)
    for _, Group in ipairs({shade1, shade2, shade3, text1, text2}) do
        for Index = #Group, 1, -1 do
            if Group[Index] == Object then
                table.remove(Group, Index)
            end
        end
    end
end

local function DestroyInstance(Object)
    if not Object then
        return
    end

    for _, Descendant in ipairs(Object:GetDescendants()) do
        UnregisterTheme(Descendant)
    end

    UnregisterTheme(Object)
    Object:Destroy()
end

local function IsValidButton(Data)
    return typeof(Data) == 'table'
        and IsFilledString(Data.text)
        and IsFilledString(Data.cmd)
        and (Data.cmd2 == nil or IsFilledString(Data.cmd2))
        and typeof(Data.pos) == 'table'
        and typeof(Data.pos[1]) == 'number'
        and typeof(Data.pos[2]) == 'number'
        and (Data.size == nil or typeof(Data.size) == 'number')
end

local function GetViewportSize()
    local Camera = workspace.CurrentCamera

    return Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
end

local function FitPosition(Position, Size)
    local Viewport = GetViewportSize()

    local X, Y = ClampPosition(Position[1], Position[2])

    return {
        math.min(X, math.max(0, Viewport.X - Size) / math.max(Viewport.X, 1)),
        math.min(Y, math.max(0, Viewport.Y - Size) / math.max(Viewport.Y, 1))
    }
end

-- // Collision
local function ToPixels(Position)
    local Viewport = GetViewportSize()

    return Vector2.new(Position[1] * Viewport.X, Position[2] * Viewport.Y)
end

local function ToScale(Position)
    local Viewport = GetViewportSize()

    return {Position.X / math.max(Viewport.X, 1), Position.Y / math.max(Viewport.Y, 1)}
end

local function IsColliding(Ignore, Position, Size)
    for _, Other in ipairs(Buttons) do
        if Other ~= Ignore then
            local OtherPosition = ToPixels(Other.Position)

            if Position.X + Size > OtherPosition.X + Config.CollisionTolerance
                and OtherPosition.X + Other.Size > Position.X + Config.CollisionTolerance
                and Position.Y + Size > OtherPosition.Y + Config.CollisionTolerance
                and OtherPosition.Y + Other.Size > Position.Y + Config.CollisionTolerance then
                return true
            end
        end
    end

    return false
end

local function MoveAlong(Data, Axis, Position, Target)
    local Cross = Axis == 'X' and 'Y' or 'X'
    local Result = Target

    for _, Other in ipairs(Buttons) do
        if Other ~= Data then
            local OtherPosition = ToPixels(Other.Position)

            local IsInLane = Position[Cross] + Data.Size > OtherPosition[Cross] + Config.CollisionTolerance
                and OtherPosition[Cross] + Other.Size > Position[Cross] + Config.CollisionTolerance

            if IsInLane then
                if Target > Position[Axis] and OtherPosition[Axis] >= Position[Axis] + Data.Size - Config.CollisionTolerance then
                    Result = math.min(Result, OtherPosition[Axis] - Data.Size)
                elseif Target < Position[Axis] and OtherPosition[Axis] + Other.Size <= Position[Axis] + Config.CollisionTolerance then
                    Result = math.max(Result, OtherPosition[Axis] + Other.Size)
                end
            end
        end
    end

    return Result
end

local function FindFreePosition(Data)
    local Viewport = GetViewportSize()
    local Desired = ToPixels(Data.Position)

    local MaximumX = math.max(0, Viewport.X - Data.Size) + Config.CollisionTolerance
    local MaximumY = math.max(0, Viewport.Y - Data.Size) + Config.CollisionTolerance

    local XCandidates = {0, Desired.X}
    local YCandidates = {0, Desired.Y}

    for _, Other in ipairs(Buttons) do
        local OtherPosition = ToPixels(Other.Position)

        table.insert(XCandidates, OtherPosition.X + Other.Size)
        table.insert(YCandidates, OtherPosition.Y + Other.Size)
    end

    local Best
    local BestDistance = math.huge

    for _, X in ipairs(XCandidates) do
        for _, Y in ipairs(YCandidates) do
            local Candidate = Vector2.new(X, Y)
            local Distance = (Candidate - Desired).Magnitude

            if X <= MaximumX and Y <= MaximumY and Distance < BestDistance and not IsColliding(Data, Candidate, Data.Size) then
                Best, BestDistance = Candidate, Distance
            end
        end
    end

    return Best
end

local function PlaceButton(Data)
    Data.Position = FitPosition(Data.Position, Data.Size)

    local Free = FindFreePosition(Data)

    if Free then
        Data.Position = ToScale(Free)
    end
end

local function FindFreeSize(Data, Requested)
    for Size = Requested, Data.Size + 1, -1 do
        local Position = FitPosition(Data.Position, Size)

        if not IsColliding(Data, ToPixels(Position), Size) then
            return Size, Position
        end
    end

    return math.min(Requested, Data.Size), Data.Position
end

-- // Files
local function SerializeButtons()
    local Saved = {}

    for _, Data in ipairs(Buttons) do
        local X, Y = ClampPosition(Data.Position[1], Data.Position[2])

        Saved[#Saved + 1] = {
            text = Data.Text,
            cmd = Data.Command,
            cmd2 = Data.SecondCommand,
            pos = {X, Y},
            size = NormalizeSize(Data.Size)
        }
    end

    return Saved
end

local function SaveButtons()
    if type(writefile) ~= 'function' then
        notify('BBinds', 'This executor does not support file writing')

        return false
    end

    local EncodeSuccess, EncodedData = pcall(function()
        return HttpService:JSONEncode(SerializeButtons())
    end)

    if not EncodeSuccess then
        warn('[BBinds] JSON encoding failed: ' .. tostring(EncodedData))
        notify('BBinds', 'Failed to encode button binds')

        return false
    end

    local WriteSuccess, WriteResult, WriteError = pcall(writefile, 'IY_BBINDS', EncodedData)

    if not WriteSuccess or WriteResult == false then
        warn('[BBinds] File write failed: ' .. tostring(WriteSuccess and WriteError or WriteResult))
        notify('BBinds', 'Failed to save button binds')

        return false
    end

    return true
end

local function LoadButtons()
    if type(isfile) ~= 'function' or type(readfile) ~= 'function' then
        return {}
    end

    local ExistsSuccess, FileExists = pcall(isfile, 'IY_BBINDS')

    if not ExistsSuccess or not FileExists then
        return {}
    end

    local ReadSuccess, RawData, ReadError = pcall(readfile, 'IY_BBINDS')

    if not ReadSuccess or RawData == false or typeof(RawData) ~= 'string' then
        warn('[BBinds] File read failed: ' .. tostring(ReadError or RawData))
        notify('BBinds', 'Failed to read saved button binds')

        return {}
    end

    local DecodeSuccess, DecodedData = pcall(function()
        return HttpService:JSONDecode(RawData)
    end)

    if not DecodeSuccess or typeof(DecodedData) ~= 'table' then
        warn('[BBinds] Invalid JSON in IY_BBINDS: ' .. tostring(DecodedData))
        notify('BBinds', 'The saved button binds file is invalid or corrupted')

        return {}
    end

    local ValidButtons = {}
    local InvalidCount = 0

    for _, Data in ipairs(DecodedData) do
        if IsValidButton(Data) then
            local X, Y = ClampPosition(Data.pos[1], Data.pos[2])

            ValidButtons[#ValidButtons + 1] = {
                Text = Trim(Data.text),
                Command = Trim(Data.cmd),
                SecondCommand = Data.cmd2 and Trim(Data.cmd2) or nil,
                Position = {X, Y},
                Size = NormalizeSize(Data.size)
            }
        else
            InvalidCount += 1
        end
    end

    if InvalidCount > 0 then
        notify('BBinds', `Skipped {InvalidCount} invalid bind(s)`)
    end

    return ValidButtons
end

