local function CreateTextButton(Parent, Name, Text, Position, Size, BackgroundColor, TextColor, ShadeGroup, TextGroup)
    local Button = Instance.new('TextButton')
    Button.Name = Name
    Button.Parent = Parent
    Button.BackgroundColor3 = BackgroundColor
    Button.BorderSizePixel = 0
    Button.Position = Position
    Button.Size = Size
    Button.Font = Enum.Font.SourceSans
    Button.TextSize = 14
    Button.Text = Text
    Button.TextColor3 = TextColor
    Button.ZIndex = 10

    RegisterTheme(Button, ShadeGroup or shade2, TextGroup or text1)

    return Button
end

