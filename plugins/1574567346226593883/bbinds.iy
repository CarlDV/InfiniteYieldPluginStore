ListFrame.ZIndex = 10

table.insert(scroll, ListFrame)

local ListLayout = Instance.new('UIListLayout')
ListLayout.Parent = ListFrame
ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
ListLayout.Padding = UDim.new(0, 5)

local function ClearListEntries()
    for _, Entry in ipairs(ListEntries) do
        DestroyInstance(Entry)
    end

    table.clear(ListEntries)
end

local function RefreshButtons()
    ClearListEntries()

    for Index, Data in ipairs(Buttons) do
        local Entry = Instance.new('Frame')
        Entry.Name = 'BBindEntry'
        Entry.Parent = ListFrame
        Entry.BackgroundColor3 = currentShade2
        Entry.BorderSizePixel = 0
        Entry.LayoutOrder = Index
        Entry.Size = UDim2.new(1, -5, 0, 20)
        Entry.ZIndex = 10

        RegisterTheme(Entry, shade2)

        local EntryText = Instance.new('TextLabel')
        EntryText.Name = 'Text'
        EntryText.Parent = Entry
        EntryText.BackgroundTransparency = 1
        EntryText.Position = UDim2.fromOffset(5, 0)
        EntryText.Size = UDim2.new(1, -68, 1, 0)
        EntryText.Font = Enum.Font.SourceSans
        EntryText.Text = `{Data.Text} > {Data.Command}{(Data.SecondCommand and ' / ' .. Data.SecondCommand) or ''} [{Data.Size}px]`
        EntryText.TextColor3 = currentText1
        EntryText.TextSize = 14
        EntryText.TextTruncate = Enum.TextTruncate.AtEnd
        EntryText.TextXAlignment = Enum.TextXAlignment.Left
        EntryText.ZIndex = 10

        RegisterTheme(EntryText, nil, text1)

        local EditEntryButton = CreateTextButton(Entry, 'Edit', 'Edit', UDim2.new(1, -58, 0, 0), UDim2.fromOffset(30, 20), currentShade3, currentText2, shade3, text2)

        local DeleteButton = CreateTextButton(Entry, 'Delete', 'X', UDim2.new(1, -25, 0, 0), UDim2.fromOffset(20, 20), currentShade3, currentText2, shade3, text2)

        EditEntryButton.Activated:Connect(function()
            OpenEditWindow(Data)
        end)

        DeleteButton.Activated:Connect(function()
            local ButtonIndex = table.find(Buttons, Data)

            if not ButtonIndex then
                return
            end

            if EditTarget == Data then
                CloseEditWindow()
            end

            DestroyInstance(Data.Gui)

            table.remove(Buttons, ButtonIndex)

            RefreshButtons()
            SaveButtons()

            notify('BBinds', `The BBind {Data.Text} has been removed`)
        end)

        ListEntries[#ListEntries + 1] = Entry
    end
end

local function RemoveAllButtons()
    CloseEditWindow()

    for _, Data in ipairs(Buttons) do
        DestroyInstance(Data.Gui)
        Data.Gui = nil
    end

    table.clear(Buttons)

    RefreshButtons()
    SaveButtons()
end

